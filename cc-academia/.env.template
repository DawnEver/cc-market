# ---------------------------------------------------------------------------
# Keep the build environment off OneDrive.
#
# This plugin lives inside cc-market, which syncs. A .venv here would be copied
# file-by-file by the sync client on every dependency change, and pytest/ruff
# caches would churn constantly. Point uv at local disk instead:
#
#   setx UV_PROJECT_ENVIRONMENT "C:\Users\<you>\Documents\PEMC\cc-academia-data\venv"
#
# The accumulating SQLite database must also stay off OneDrive -- sync corrupts
# database files. ACADEMIA_DB already defaults to local disk.
# ---------------------------------------------------------------------------

# Optional. OpenAlex/Crossref polite pool -- markedly better rate limits.
ACADEMIA_CONTACT=you@example.com

# Optional. Without a key the Semantic Scholar author endpoints return HTTP 429
# immediately; cc-academia falls back to OpenAlex, which is the primary author source.
S2_API_KEY=

# Optional. Zotero bridge.
ZOTERO_API_KEY=
ZOTERO_LIBRARY_ID=
ZOTERO_LIBRARY_TYPE=user
ZOTERO_LOCAL=true

# Optional. AI backends for deep-read / synthesis / profiling.
MOONSHOT_API_KEY=
DEEPSEEK_API_KEY=
