# ---------------------------------------------------------------------------
# Keep the build environment off OneDrive.
#
# This plugin lives inside cc-market, which syncs. A .venv here would be copied
# file-by-file by the sync client on every dependency change, and pytest/ruff
# caches would churn constantly. Point uv at local disk instead:
#
#   setx UV_PROJECT_ENVIRONMENT "C:\Users\<you>\Documents\cc-academia-data\venv"
#
# The accumulating SQLite database must also stay off OneDrive -- sync corrupts
# database files. ACADEMIA_DB already defaults to local disk.
# ---------------------------------------------------------------------------

# Optional. OpenAlex/Crossref polite pool -- markedly better rate limits.
ACADEMIA_CONTACT=you@example.com

# Strongly recommended. Free from openalex.org. Anonymous access is metered in
# credits: 1000/day at 10 per request, so about 100 requests -- less than one
# multi-query review, after which every query answers HTTP 429. A key raises the
# daily limit to 10000 credits, about 1000 requests.
OPENALEX_API_KEY=

# Optional. Without a key the Semantic Scholar author endpoints return HTTP 429
# immediately; cc-academia falls back to OpenAlex, which is the primary author source.
S2_API_KEY=

# Optional. Scopus, free from dev.elsevier.com. Needed only by the bibliometric
# work: journal-article counts per year, and the author position -- first author
# or not -- that comes with them, which no other source states. The key must
# carry Search API access, which institutional keys do. The weekly quota is
# finite, so a multi-source literature search never reaches Scopus unless a
# caller names it.
SCOPUS_API_KEY=

# Optional, and rarely needed: only for keys issued with an institutional
# token. An empty value is not the same as an absent header to this API, so
# omit the line rather than leaving it blank if you have no token.
# SCOPUS_INST_TOKEN=

# Optional. Zotero bridge.
ZOTERO_API_KEY=
ZOTERO_LIBRARY_ID=
ZOTERO_LIBRARY_TYPE=user
ZOTERO_LOCAL=true

# Optional. AI backends for deep-read / synthesis / profiling.
MOONSHOT_API_KEY=
DEEPSEEK_API_KEY=
