        "dc:identifier": "SCOPUS_ID:85165615464",
        "eid": "2-s2.0-85165615464",
        "dc:title": "PERMANENT MAGNET SYNCHRONOUS MOTOR TORQUE RIPPLE REDUCTION USING PREDICTIVE TORQUE CONTROL",
        "dc:creator": "Bahar S.T.",
        "prism:publicationName": "Journal of Engineering and Sustainable Development",
        "prism:issn": "25200917",
        "prism:eIssn": "25200925",
