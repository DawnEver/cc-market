        "dc:identifier": "SCOPUS_ID:85128619172",
        "eid": "2-s2.0-85128619172",
        "dc:title": "PMSM Torque Ripple Minimization Based on Novel Low Carrier Ratio PWM Technique",
        "dc:creator": "Yi P.",
        "prism:publicationName": "IEEE Transactions on Power Electronics",
        "prism:issn": "08858993",
        "prism:eIssn": "19410107",
        "prism:volume": "37",
        "prism:issueIdentifier": "9",
        "prism:pageRange": "11071-11084",
