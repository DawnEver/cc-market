{
  "schema_version": 2,
  "files": {
    "profiles": "profiles.json",
    "principles": "principles.json",
    "finding_schema": "finding.schema.json",
    "output_schema": "findings-output.schema.json",
    "conformance": "conformance"
  },
  "pick": {
    "count": 2,
    "algorithm": "weighted_without_replacement",
    "eligible": "profiles whose source fired; every profile when no source is given",
    "empty_fallback": "diff",
    "assignment": "shuffled"
  },
  "contexts": {
    "diff": {
      "review": {
        "template": "prompts/diff.md",
        "call_mode": "review"
      },
      "agent": {
        "template": "prompts/agent-diff.md",
        "call_mode": "agent"
      },
      "empty": {
        "status": "skipped"
      }
    },
    "explore": {
      "any": {
        "template": "prompts/explore.md",
        "call_mode": "agent"
      }
    }
  },
  "template": {
    "placeholder": "{{name}}",
    "missing": "",
    "list_join": "; ",
    "collapse_blank_lines": true,
    "trim": true,
    "partials": {
      "principles": "prompts/principles.md",
      "output_contract": "prompts/output-contract.md"
    }
  },
  "run_modes": {
    "interactive": {
      "providers": {
        "from": "available",
        "order": "alphabetical",
        "rotate_by": "seed",
        "count": 2
      },
      "call_modes": [
        "review",
        "agent"
      ],
      "models": {
        "claude": "opus"
      },
      "synthesis": false,
      "sink": "memory"
    },
    "headless": {
      "providers": [
        "anthropic"
      ],
      "contexts": [
        "diff"
      ],
      "call_modes": [
        "review"
      ],
      "models": {},
      "synthesis": false,
      "sink": "stdout"
    }
  },
  "provider_assignment": "reviewer i takes providers[i mod len(providers)]; a requested provider absent from the available set is status unavailable, never substituted",
  "reviewer_status": {
    "vocabulary": [
      "ok",
      "exhausted",
      "auth",
      "rate_limit",
      "timeout",
      "unsupported",
      "unavailable",
      "skipped"
    ],
    "failure_kinds": [
      "exhausted",
      "auth",
      "rate_limit",
      "timeout",
      "unsupported"
    ],
    "planned_final": [
      "unavailable",
      "skipped",
      "unsupported"
    ],
    "precedence": [
      "planned_final",
      "missing_result:unavailable",
      "error_kind",
      "placeholder_reply:unavailable",
      "findings_array:ok",
      "otherwise:unavailable"
    ],
    "placeholder_replies": [
      "^\\s*\\(no findings"
    ],
    "error": "every reviewer whose status is neither ok nor skipped carries a non-empty error naming why: the recorded error text (the result's `error`, else the planned reviewer's `error`) when it is a non-empty string, else the reason of the precedence rule that decided the status ({error_kind} replaced by the recorded kind). An ok reviewer never carries one; a skipped one carries none from the merge. The text is copied, never a key.",
    "reasons": {
      "planned_final": {
        "unavailable": "the requested provider is not available here",
        "unsupported": "the run mode cannot execute this reviewer's call mode"
      },
      "missing_result": "no result came back",
      "error_kind": "the call failed with kind {error_kind} and recorded no error text",
      "placeholder_reply": "the reply was only a no-findings placeholder",
      "otherwise": "the reply held no findings array"
    }
  },
  "merge": {
    "validate": "finding_schema",
    "dedup_key": {
      "fields": [
        "file",
        "summary"
      ],
      "lowercase": true,
      "truncate": 60,
      "join": "|"
    },
    "group_order": "first_seen",
    "primary": "first_seen",
    "defaults": {
      "file": "",
      "status": "OPEN",
      "suggestion": "",
      "detail": ""
    },
    "confidence": [
      {
        "min_reviewers": 2,
        "label": "high-confidence (≥2 reviewers)"
      },
      {
        "min_reviewers": 1,
        "label": "single-reviewer"
      }
    ],
    "id": {
      "prefix": "SR",
      "date_format": "YYYYMMDD",
      "seq_width": 3,
      "seq_start": 1,
      "separator": "-"
    },
    "union": {
      "fields": [
        "principles"
      ],
      "order": "first_seen",
      "empty": "omitted"
    }
  },
  "principles": {
    "finding_field": "principles",
    "fills": "the finding schema property finding_field gets items.enum = every principles.json id, at load; the file never lists them",
    "list_item": "- {{id}}: {{statement}}",
    "prompt_schema": "unfilled",
    "prompt_schema_means": "filled: the prompt's finding schema carries the ids enum; unfilled: it does not, since the principles partial already lists every id. Validation always uses the filled schema"
  }
}
