#!/usr/bin/env bash
# Read-only release guard. A push hook must never rewrite history or create tags.
set -euo pipefail

need_release=0
remote_name="${1:-origin}"
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "${local_sha:-}" ] || continue
  [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue
  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    remote_default="refs/remotes/$remote_name/main"
    if git rev-parse --verify "$remote_default" >/dev/null 2>&1; then
      base="$(git merge-base "$local_sha" "$remote_default")"
    else
      base="$(git hash-object -t tree /dev/null)"
    fi
  else
    base="$remote_sha"
  fi
  changed="$(git diff --name-only "$base..$local_sha")"
  releasable=0
  printf '%s\n' "$changed" | grep -q '^shared/' && releasable=1 || true
  while IFS= read -r path; do
    top="${path%%/*}"
    [ "$top" != "$path" ] || continue
    if git cat-file -e "$local_sha:$top/.claude-plugin/plugin.json" 2>/dev/null; then
      releasable=1
      break
    fi
  done <<< "$changed"
  if [ "$releasable" -eq 1 ]; then
    version="$(git show "$local_sha:.claude-plugin/marketplace.json" 2>/dev/null | node -e "let s='';process.stdin.on('data',d=>s+=d).on('end',()=>process.stdout.write(JSON.parse(s).version))" 2>/dev/null || true)"
    [ -n "$version" ] && git tag --points-at "$local_sha" | grep -Fxq "v$version" || need_release=1
  fi
done

if [ "$need_release" -eq 1 ]; then
  echo "pre-push: releasable plugin changes are not tagged." >&2
  echo "Run 'bash scripts/release.sh', review its release commit, then push again." >&2
  exit 1
fi
