#!/usr/bin/env bash
# Pre-commit hook — run only the tests for plugins whose files are staged.
# Mirrors pre-push's changed-plugin discovery, but against the index (git diff --cached).
# shared/ changing fans out to every plugin (shared/ is bundled into each).
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

# Top-level dirs touched in the staged change set.
changed_dirs="$(git diff --cached --name-only | sed -n 's#^\([^/]*\)/.*#\1#p' | sort -u)"

# Public-hygiene guard: this repo is published — staged files must not carry machine-local
# or personal data (home paths, personal emails, chat ids, ~/.claude/private-markers).
node scripts/check-public-hygiene.mjs --staged

# Runtime self-containment lint: runtime-delivered markdown (skills/*/SKILL.md,
# skills/*/reference/*.md, commands/*, prompts/*, agents/*) must NOT defer to the plugin's
# own dev-only docs. AGENTS.md and .claude/rules are injected only in the DEV repo — when a
# skill actually runs, only its SKILL.md + the reference files it reads are loaded. A
# "→ AGENTS.md § X" / "see AGENTS.md § X" deferral therefore means the execution knowledge
# never reaches the runtime agent (the evolve round-protocol circularity was exactly this).
# Host-project artifacts (.claude/rules/, a project AGENTS.md) ARE injected at runtime and
# are fine; this regex only flags deferrals to a bare AGENTS/CLAUDE doc.
runtime_re='(AGENTS|CLAUDE)\.md[[:space:]]*§|→[[:space:]]*(AGENTS|CLAUDE)'
runtime_re_file='/(skills/[^/]+/(SKILL\.md|reference/.*\.md)|commands/.*\.md|prompts/.*\.md|agents/.*\.md)$'
runtime_violations=""
while IFS= read -r f; do
  printf '%s\n' "$f" | grep -qE "$runtime_re_file" || continue
  hit="$(grep -nE "$runtime_re" "$f" || true)"
  if [ -n "$hit" ]; then
    runtime_violations="$runtime_violations
$(printf '%s' "$hit" | sed "s#^#$f: #")"
  fi
done < <(git diff --cached --name-only || true)
if [ -n "$runtime_violations" ]; then
  echo "pre-commit: runtime file defers to dev-only plugin docs (AGENTS.md/CLAUDE.md are not injected at runtime):"
  printf '%s\n' "$runtime_violations"
  exit 1
fi

node_tests=()       # plugin dirs whose *.test.mjs run via node --test
run_bundle=0        # tests/bundle-integrity.test.mjs
fanout=0            # shared/ touched -> run everything

has() { printf '%s\n' "$changed_dirs" | grep -qx "$1"; }

# shared/ is bundled into every plugin; tests/ is the cross-cutting bundle check.
if has shared || has tests; then
  fanout=1
fi

if [ "$fanout" -eq 1 ]; then
  node_tests=(rem sharp-review traceme evolve fabric cc-latex)
  run_bundle=1
else
  for p in rem sharp-review traceme evolve fabric cc-latex; do
    has "$p" && node_tests+=("$p") && run_bundle=1
  done
  has watch && run_bundle=1
  # Academia's dependency-heavy pytest remains a CI gate, but its manifest/host policy
  # changes must still receive the fast generated-artifact checks locally.
  has cc-academia && run_bundle=1
fi

if [ "${#node_tests[@]}" -eq 0 ] && [ "$run_bundle" -eq 0 ]; then
  echo "pre-commit: no plugin tests affected by staged changes — skipping."
  exit 0
fi

selected=()
if [ "$run_bundle" -eq 1 ]; then
  selected+=("tests/bundle-integrity.test.mjs" "tests/gen-codex.test.mjs")
fi
# shared/ owns the canonical modules bundled into every plugin — run its own suite when touched.
{ has shared || has tests; } && selected+=("shared/tests/*.test.mjs")
if [ "${#node_tests[@]}" -gt 0 ]; then
  for p in "${node_tests[@]}"; do
    selected+=("$p/tests/*.test.mjs")
  done
fi

failed=0
# Unset GIT_* so tests that spin up temp git repos (e.g. check-docs CLI) don't inherit
# this commit's index/dir — git exports GIT_DIR/GIT_INDEX_FILE into hooks, and those tests
# would otherwise operate on the real repo and fail spuriously..
for glob in "${selected[@]}"; do
  if ! env -u GIT_DIR -u GIT_INDEX_FILE -u GIT_WORK_TREE -u GIT_PREFIX \
          -u GIT_OBJECT_DIRECTORY -u GIT_COMMON_DIR \
          node --test $glob > /dev/null 2>&1; then
    echo "FAIL: $glob"
    failed=1
  fi
done

if [ "$failed" -ne 0 ]; then
  echo ""
  echo "Tests failed. Run manually:"
  for glob in "${selected[@]}"; do
    echo "  node --test $glob"
  done
  exit 1
fi

echo "All affected plugin tests passed."
